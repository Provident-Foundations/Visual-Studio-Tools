<UserControl x:Class="VS.Toolset.UI.Controls.NamingHierarchyControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Focusable="False">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Padding="10" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
			<StackPanel>
				<TextBlock Text="Analysis target" FontWeight="SemiBold" FontSize="15" />
				<TextBlock Text="{Binding Result.Target.Name, TargetNullValue=Unavailable}" FontSize="14" Margin="0,4,0,0" AutomationProperties.Name="Analysis target name" />
				<TextBlock Text="{Binding Result.Target.Scope, TargetNullValue=Unavailable, StringFormat=Scope: {0}}" Margin="0,2,0,0" />
				<TextBlock Text="{Binding Result.Target.Path, TargetNullValue=Target path unavailable}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.Name="Analysis target path" />
				<TextBlock Text="{Binding Result.Status, TargetNullValue=No analysis result}" Margin="0,4,0,0" />
				<TextBlock Text="Expand a project to inspect its own patterns, violations, and diagnostics. Project details are unfiltered; the report filters select projects but do not filter these nested lists. Patterns are inferred conventions, not authoritative rules." TextWrapping="Wrap" Margin="0,4,0,0" />
			</StackPanel>
		</Border>

		<TextBlock Grid.Row="1" Text="No analysis result is available." Margin="4,0,4,8" AutomationProperties.LiveSetting="Polite">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Result}" Value="{x:Null}">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>

		<Grid Grid.Row="2">
			<TextBlock Text="No projects match the current report filter, or the analysis returned no project entries." Margin="4" AutomationProperties.LiveSetting="Polite">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding Projects.Count}" Value="0">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
							<DataTrigger Binding="{Binding Result}" Value="{x:Null}">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>

			<ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}"
					 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
					 AutomationProperties.Name="Projects in naming analysis"
					 ScrollViewer.CanContentScroll="True"
					 VirtualizingPanel.IsVirtualizing="True"
					 VirtualizingPanel.VirtualizationMode="Standard"
					 KeyboardNavigation.TabNavigation="Local">
				<ListBox.Style>
					<Style TargetType="ListBox">
						<Setter Property="Visibility" Value="Visible" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
						<Setter Property="BorderThickness" Value="0" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding Result}" Value="{x:Null}">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ListBox.Style>
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0,0,0,6" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Expander IsExpanded="False" Expanded="OnProjectExpanded" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Project details">
							<Expander.Header>
								<Grid Margin="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="3*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" MinWidth="160">
										<TextBlock Text="{Binding Project.Name, TargetNullValue=Project name unavailable}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Project.FilePath, TargetNullValue=Project path unavailable}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
									</StackPanel>
									<TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center" AutomationProperties.Name="Project analysis status" />
									<TextBlock Grid.Column="2" Text="{Binding Result.Statistics.IdentifierCount, TargetNullValue=Unavailable, FallbackValue=Unavailable, StringFormat=Names: {0}}" Margin="8,0" VerticalAlignment="Center" AutomationProperties.Name="Analyzed name count" />
								</Grid>
							</Expander.Header>
							<TabControl Margin="8" AutomationProperties.Name="Project naming data">
								<TabItem Header="Patterns">
									<Grid Margin="4">
										<DataGrid ItemsSource="{Binding Result.Patterns}"
												  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
												  EnableRowVirtualization="True" EnableColumnVirtualization="True"
												  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
												  ScrollViewer.CanContentScroll="True" Height="220"
												  AutomationProperties.Name="Project naming patterns">
											<DataGrid.Columns>
												<DataGridTextColumn Header="Kind" Binding="{Binding Scope.SymbolKind, TargetNullValue=Unspecified}" />
												<DataGridTextColumn Header="Language" Binding="{Binding Scope.Language, TargetNullValue=Unspecified}" />
												<DataGridTextColumn Header="Namespace" Binding="{Binding Scope.Namespace, TargetNullValue=Unspecified}" />
												<DataGridTextColumn Header="Style" Binding="{Binding DominantStyle}" />
												<DataGridTextColumn Header="Names" Binding="{Binding ObservationCount}" />
												<DataGridTextColumn Header="Matching" Binding="{Binding MatchingCount}" />
												<DataGridTextColumn Header="Dominance" Binding="{Binding DominancePercentage, StringFormat=P0}" />
												<DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" />
												<DataGridCheckBoxColumn Header="Mixed" Binding="{Binding IsMixed}" />
												<DataGridCheckBoxColumn Header="Insufficient evidence" Binding="{Binding HasInsufficientEvidence}" />
											</DataGrid.Columns>
										</DataGrid>
										<TextBlock Text="Project pattern data is unavailable because no project analysis result was returned." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<TextBlock Text="No project patterns were reported." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding Result.Patterns.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</TabItem>
								<TabItem Header="Violations">
									<Grid Margin="4">
										<DataGrid ItemsSource="{Binding Result.Violations}"
												  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
												  EnableRowVirtualization="True" EnableColumnVirtualization="True"
												  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
												  ScrollViewer.CanContentScroll="True" Height="220"
												  MouseDoubleClick="OnSourceRowMouseDoubleClick" PreviewKeyDown="OnSourceRowPreviewKeyDown"
												  AutomationProperties.Name="Project naming violations; press Enter or double-click to request source navigation">
											<DataGrid.Columns>
												<DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
												<DataGridTextColumn Header="Name" Binding="{Binding Name}" />
												<DataGridTextColumn Header="Expected" Binding="{Binding ExpectedStyle}" />
												<DataGridTextColumn Header="Actual" Binding="{Binding ActualStyle}" />
												<DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" />
												<DataGridTextColumn Header="Suggestion" Binding="{Binding SuggestedName, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="File" Binding="{Binding Location.FilePath, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="Line" Binding="{Binding Location.StartLine, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="Reason" Binding="{Binding Message}" />
											</DataGrid.Columns>
										</DataGrid>
										<TextBlock Text="Project violation data is unavailable because no project analysis result was returned." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers><DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<TextBlock Text="No project violations were reported." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers><DataTrigger Binding="{Binding Result.Violations.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</TabItem>
								<TabItem Header="Diagnostics">
									<Grid Margin="4">
										<DataGrid ItemsSource="{Binding Diagnostics}"
												  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
												  EnableRowVirtualization="True" EnableColumnVirtualization="True"
												  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
												  ScrollViewer.CanContentScroll="True" Height="220"
												  MouseDoubleClick="OnSourceRowMouseDoubleClick" PreviewKeyDown="OnSourceRowPreviewKeyDown"
												  AutomationProperties.Name="Project diagnostics; press Enter or double-click to request source navigation">
											<DataGrid.Columns>
												<DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
												<DataGridTextColumn Header="Code" Binding="{Binding Code}" />
												<DataGridTextColumn Header="Message" Binding="{Binding Message}" />
												<DataGridTextColumn Header="Detail" Binding="{Binding Detail, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="File" Binding="{Binding Location.FilePath, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="Line" Binding="{Binding Location.StartLine, TargetNullValue=Unavailable}" />
												<DataGridTextColumn Header="Project path" Binding="{Binding ProjectPath, TargetNullValue=Unavailable}" />
											</DataGrid.Columns>
										</DataGrid>
										<TextBlock Text="Diagnostic data is unavailable for this project." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers><DataTrigger Binding="{Binding Diagnostics}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<TextBlock Text="No project diagnostics were reported." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers><DataTrigger Binding="{Binding Diagnostics.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</TabItem>
							</TabControl>
						</Expander>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>
</UserControl>
