<base:ProvidentWindowBase
	x:Class="VS.Toolset.UI.Dialogs.FileEditorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
	xmlns:base="clr-namespace:Provident.Foundations.Wpf.Controls;assembly=Provident.Foundations.Wpf.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:VS.Toolset.UI.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="FileEditorDialog"
	Title="Edit"
	Width="800"
	Height="450"
	MinWidth="200"
	MinHeight="200"
	HorizontalAlignment="Stretch"
	VerticalAlignment="Stretch"
	Background="{DynamicResource WindowBrush}"
	FontFamily="Consolas"
	Foreground="{DynamicResource TextBrush}"
	mc:Ignorable="d">
	<Grid x:Name="MainLayoutGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="10" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="10" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="24" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="20" />
		</Grid.RowDefinitions>
		<ToolBarPanel
			x:Name="MainToolbarPanel"
			Grid.Row="0"
			Grid.Column="1"
			Grid.ColumnSpan="11"
			Margin="0"
			Background="{DynamicResource WindowBrush}">
			<ToolBar
				x:Name="MainToolbar"
				Height="22"
				Margin="0"
				Padding="0"
				Background="{DynamicResource SurfaceBrush}">
				<Button
					x:Name="SaveButton"
					Width="18"
					Height="18"
					VerticalAlignment="Stretch"
					Background="Transparent"
					BorderBrush="Transparent"
					Click="HandleSaveClicked"
					ToolTip="Save">
					<Image Source="/Dialogs/Save Icons 3.png" Stretch="Uniform" />
				</Button>
				<Button
					x:Name="CloseButton"
					Width="18"
					Height="18"
					VerticalAlignment="Stretch"
					Background="Transparent"
					BorderBrush="Transparent"
					Click="HandleCloseClicked"
					ToolTip="Close">
					<Image Source="/Dialogs/Cancel Delete Icons 1.png" Stretch="Uniform" />
				</Button>
			</ToolBar>
		</ToolBarPanel>
		<avalonEdit:TextEditor
			x:Name="TextEditor"
			Grid.Row="1"
			Grid.RowSpan="7"
			Grid.Column="1"
			Grid.ColumnSpan="11"
			Padding="8"
			Background="{DynamicResource EditorBackgroundBrush}"
			Document="{Binding Document}"
			FontFamily="Consolas"
			FontSize="12"
			Foreground="{DynamicResource EditorForegroundBrush}"
			HorizontalScrollBarVisibility="Auto"
			IsReadOnly="False"
			ShowLineNumbers="True"
			VerticalScrollBarVisibility="Auto"
			WordWrap="False" />
		<Grid
			x:Name="StatusBar"
			Grid.Row="8"
			Grid.Column="0"
			Grid.ColumnSpan="13"
			Background="{DynamicResource SurfaceBrush}">
			<Label
				x:Name="StatusLabel"
				Padding="5,0,0,0"
				VerticalContentAlignment="Center"
				Content="Ready"
				Foreground="{DynamicResource TextBrush}" />
		</Grid>
	</Grid>
</base:ProvidentWindowBase>
