<base:ProvidentWindowBase
	x:Class="VS.Toolset.UI.Dialogs.SqlMakerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="clr-namespace:Provident.Foundations.Wpf.Controls;assembly=Provident.Foundations.Wpf.Controls"
	Title="New SQL Maker Project"
	Width="1024"
	Height="760"
	MinWidth="820"
	MinHeight="660"
	Background="{DynamicResource WindowBrush}"
	Closing="OnClosing"
	Foreground="{DynamicResource TextBrush}"
	WindowStartupLocation="CenterOwner">
	<Window.Resources>
		<Style TargetType="Label">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Padding" Value="0,0,0,5" />
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="MinHeight" Value="36" />
		</Style>
		<Style TargetType="PasswordBox">
			<Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="MinHeight" Value="36" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="MinHeight" Value="38" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							x:Name="ButtonBorder"
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="3">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								RecognizesAccessKey="True" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Key="PrimaryButtonStyle"
			BasedOn="{StaticResource {x:Type Button}}"
			TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style TargetType="TabControl">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>
		<Style TargetType="TabItem">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="Padding" Value="18,10" />
			<Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		</Style>
		<Style TargetType="Expander">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		</Style>
		<Style TargetType="ListView">
			<Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="275" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Border Grid.Column="0" Background="{DynamicResource PanelGradient}">
			<DockPanel Margin="24,28,20,22">
				<StackPanel Margin="0,16,0,0" DockPanel.Dock="Bottom">
					<TextBlock
						FontSize="14"
						Foreground="{DynamicResource TextBrush}"
						Text="SQL Maker" />
					<TextBlock
						Margin="0,4,0,0"
						Foreground="{DynamicResource MutedTextBrush}"
						Text="Build your data project" />
				</StackPanel>
				<Image
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Source="/Dialogs/SqlServerBanner.png"
					Stretch="UniformToFill"
					StretchDirection="DownOnly" />
			</DockPanel>
		</Border>
		<Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
			<DockPanel Margin="30,22,30,22">
				<StackPanel Margin="0,0,0,16" DockPanel.Dock="Top">
					<TextBlock
						FontSize="30"
						FontWeight="Bold"
						Foreground="{DynamicResource TextBrush}"
						Text="New SQL Maker Project" />
					<TextBlock
						Margin="0,4,0,14"
						FontSize="14"
						Foreground="{DynamicResource MutedTextBrush}"
						Text="Configure your project, data access options, and database tables." />
					<Border Height="1" Background="{DynamicResource BorderBrush}" />
				</StackPanel>
				<StackPanel
					Margin="0,16,0,0"
					HorizontalAlignment="Right"
					DockPanel.Dock="Bottom"
					Orientation="Horizontal">
					<Button
						Margin="0,0,8,0"
						Content="Cancel"
						IsCancel="True" />
					<Button
						Command="{Binding SaveCommand}"
						Content="Save Project..."
						IsDefault="True"
						Style="{StaticResource PrimaryButtonStyle}" />
				</StackPanel>
				<TabControl x:Name="ProjectTabs">
					<TabItem Header="Properties">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="18">
								<Label Content="Project name" Target="{Binding ElementName=ProjectName}" />
								<TextBox
									x:Name="ProjectName"
									Margin="0,0,0,14"
									Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Description" Target="{Binding ElementName=Description}" />
								<TextBox
									x:Name="Description"
									Height="80"
									Margin="0,0,0,18"
									AcceptsReturn="True"
									Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto" />
								<TextBlock
									Margin="0,0,0,8"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="SQL Server connection" />
								<Border
									Margin="0,0,0,14"
									Padding="14"
									Background="{DynamicResource RaisedBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="4">
									<DockPanel>
										<Button
											x:Name="ConfigureConnectionButton"
											Margin="12,0,0,0"
											Command="{Binding ConfigureConnectionCommand}"
											Content="Connect..."
											DockPanel.Dock="Right" />
										<StackPanel VerticalAlignment="Center">
											<TextBlock
												FontWeight="SemiBold"
												Foreground="{DynamicResource TextBrush}"
												Text="Connection status" />
											<TextBlock
												x:Name="ConnectionSummary"
												Margin="0,4,0,0"
												Foreground="{DynamicResource MutedTextBrush}"
												Text="{Binding ConnectionSummary}"
												TextWrapping="Wrap" />
										</StackPanel>
									</DockPanel>
								</Border>
								<Expander Margin="0,0,0,14" Header="Use a connection string instead">
									<StackPanel Margin="0,12,0,0">
										<TextBlock
											Margin="0,0,0,8"
											Foreground="{DynamicResource MutedTextBrush}"
											Text="A nonempty connection string overrides the guided connection and is not verified until tables are loaded."
											TextWrapping="Wrap" />
										<Label Content="Connection string" Target="{Binding ElementName=ConnectionString}" />
										<PasswordBox
											x:Name="ConnectionString"
											Margin="0,0,0,8"
											IsEnabled="{Binding IsNotLoading}"
											PasswordChanged="ConnectionStringChanged" />
									</StackPanel>
								</Expander>
								<TextBlock
									Foreground="{DynamicResource MutedTextBrush}"
									Text="Passwords are not stored in the project; they must be supplied again when connecting."
									TextWrapping="Wrap" />
							</StackPanel>
						</ScrollViewer>
					</TabItem>
					<TabItem Header="Options">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="18">
								<Label Content="Data access class namespace" Target="{Binding ElementName=DataAccessNamespace}" />
								<TextBox
									x:Name="DataAccessNamespace"
									Margin="0,0,0,12"
									Text="{Binding DataAccessNamespace, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Entity class namespace" Target="{Binding ElementName=EntityNamespace}" />
								<TextBox
									x:Name="EntityNamespace"
									Margin="0,0,0,12"
									Text="{Binding EntityNamespace, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Stored procedure prefix" Target="{Binding ElementName=ProcedurePrefix}" />
								<TextBox
									x:Name="ProcedurePrefix"
									Margin="0,0,0,12"
									Text="{Binding ProcedurePrefix, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Stored procedure suffix" Target="{Binding ElementName=ProcedureSuffix}" />
								<TextBox
									x:Name="ProcedureSuffix"
									Margin="0,0,0,16"
									Text="{Binding ProcedureSuffix, UpdateSourceTrigger=PropertyChanged}" />
								<CheckBox
									x:Name="GenerateJoins"
									Margin="0,0,0,10"
									Content="Generate relational child objects"
									IsChecked="{Binding GenerateJoins, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Child object prefix" Target="{Binding ElementName=JoinPrefix}" />
								<TextBox
									x:Name="JoinPrefix"
									Margin="0,0,0,12"
									Text="{Binding JoinPrefix, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Child object suffix" Target="{Binding ElementName=JoinSuffix}" />
								<TextBox
									x:Name="JoinSuffix"
									Margin="0,0,0,12"
									Text="{Binding JoinSuffix, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Default identity column" Target="{Binding ElementName=IdColumn}" />
								<TextBox
									x:Name="IdColumn"
									Margin="0,0,0,16"
									Text="{Binding IdColumn, UpdateSourceTrigger=PropertyChanged}" />
								<CheckBox
									x:Name="SoftDelete"
									Margin="0,0,0,10"
									Content="Use soft deletes"
									IsChecked="{Binding SoftDelete, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Soft delete column" Target="{Binding ElementName=SoftDeleteColumn}" />
								<TextBox
									x:Name="SoftDeleteColumn"
									Margin="0,0,0,16"
									Text="{Binding SoftDeleteColumn, UpdateSourceTrigger=PropertyChanged}" />
								<CheckBox
									x:Name="UseRegions"
									Margin="0,0,0,12"
									Content="Generate code regions"
									IsChecked="{Binding UseRegions, UpdateSourceTrigger=PropertyChanged}" />
								<Label Content="Standard namespaces (one per line)" Target="{Binding ElementName=StandardNamespaces}" />
								<TextBox
									x:Name="StandardNamespaces"
									Height="100"
									Margin="0,0,0,12"
									AcceptsReturn="True"
									Text="{Binding StandardNamespaces, UpdateSourceTrigger=PropertyChanged}"
									VerticalScrollBarVisibility="Auto" />
								<TextBlock
									Foreground="{DynamicResource MutedTextBrush}"
									Text="These settings are saved with the project. The archived SQL Maker does not include a code generator."
									TextWrapping="Wrap" />
							</StackPanel>
						</ScrollViewer>
					</TabItem>
					<TabItem Header="Tables">
						<DockPanel Margin="18">
							<StackPanel Margin="0,0,0,12" DockPanel.Dock="Top">
								<TextBlock
									Margin="0,0,0,10"
									Foreground="{DynamicResource MutedTextBrush}"
									Text="Load the tables from the connection on the Properties tab, then check those to include in the project."
									TextWrapping="Wrap" />
								<Button
									x:Name="LoadTablesButton"
									HorizontalAlignment="Left"
									Command="{Binding LoadTablesCommand}"
									Content="Load Tables" />
							</StackPanel>
							<ListView
								x:Name="TablesList"
								ItemsSource="{Binding Tables}"
								SelectionMode="Multiple">
								<ListView.ItemTemplate>
									<DataTemplate>
										<CheckBox
											Margin="6"
											Content="{Binding DisplayName}"
											IsChecked="{Binding IsSelected}" />
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</DockPanel>
					</TabItem>
				</TabControl>
			</DockPanel>
		</Border>
	</Grid>
</base:ProvidentWindowBase>
