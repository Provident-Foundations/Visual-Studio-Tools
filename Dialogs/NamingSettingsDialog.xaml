<Window x:Class="VS.Toolset.UI.Dialogs.NamingSettingsDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Naming analysis settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="20" MinWidth="360">
		<TextBlock Text="Settings apply to the next analysis in this session." TextWrapping="Wrap" Margin="0,0,0,12" />
		<CheckBox x:Name="IncludeXaml" Content="Analyze XAML identifiers" Margin="0,4" />
		<CheckBox x:Name="IncludeGenerated" Content="Analyze generated files" Margin="0,4" />
		<TextBlock Text="Minimum observations per pattern" Margin="0,12,0,2" />
		<TextBox x:Name="MinimumObservations" AutomationProperties.Name="Minimum observations per pattern" />
		<TextBlock Text="Minimum dominance (0 to 1)" Margin="0,8,0,2" />
		<TextBox x:Name="MinimumDominance" AutomationProperties.Name="Minimum dominance from zero to one" />
		<TextBlock Text="Minimum violation confidence (0 to 1)" Margin="0,8,0,2" />
		<TextBox x:Name="MinimumConfidence" AutomationProperties.Name="Minimum violation confidence from zero to one" />
		<TextBlock Text="C# reference resolution is unavailable; observed XAML references may still be counted." TextWrapping="Wrap" Margin="0,12,0,0" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Apply" IsDefault="True" Padding="14,5" Margin="0,0,8,0" Click="ApplySettings" />
			<Button Content="Cancel" IsCancel="True" Padding="14,5" />
		</StackPanel>
	</StackPanel>
</Window>
