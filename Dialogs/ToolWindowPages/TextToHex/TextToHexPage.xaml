<Page
	x:Class="VS.Toolset.UI.Dialogs.ToolWindowPages.TextToHex.TextToHexPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:VS.Toolset.UI.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
	Title="Convert Text To Hexadecimal"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Page.Resources>
		<Style x:Key="TextToHexButtonStyle" TargetType="Button">
			<Setter Property="MinHeight" Value="40" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontFamily" Value="Segoe UI" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							x:Name="ButtonBorder"
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								RecognizesAccessKey="True" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
								<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
								<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Page.Resources>
	<Border
		Background="{DynamicResource WindowBrush}"
		BorderBrush="{DynamicResource AccentBrush}"
		BorderThickness="4">
		<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<Grid
				MinWidth="350"
				MinHeight="400"
				Background="{DynamicResource SurfaceBrush}">
				<Grid.RowDefinitions>
					<RowDefinition Height="40" />
					<RowDefinition Height="5" />
					<RowDefinition Height="20" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
					<RowDefinition Height="30" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="125" />
				</Grid.ColumnDefinitions>
				<Grid
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="12"
					Background="{DynamicResource HeaderGradient}">
					<TextBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontFamily="Segoe UI"
						FontSize="24"
						FontWeight="Bold"
						Foreground="{DynamicResource TitleTextBrush}"
						IsHitTestVisible="False"
						Text="Convert Text To Hexadecimal">
						<TextBlock.Effect>
							<DropShadowEffect RenderingBias="Quality" ShadowDepth="3" />
						</TextBlock.Effect>
					</TextBlock>
				</Grid>
				<Border
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="12"
					Background="{DynamicResource AccentBrush}" />

				<Label
					Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="12"
					Padding="0"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					HorizontalContentAlignment="Left"
					VerticalContentAlignment="Center"
					Content="_Enter Text (UTF-8):"
					FontFamily="Segoe UI"
					FontSize="13"
					Foreground="{DynamicResource TextBrush}"
					Target="{Binding ElementName=OriginalText}" />
				<TextBox
					x:Name="OriginalText"
					Grid.Row="3"
					Grid.RowSpan="3"
					Grid.Column="0"
					Grid.ColumnSpan="10"
					Margin="5,0,0,0"
					Padding="4"
					AcceptsReturn="True"
					AutomationProperties.Name="Text to convert"
					Background="{DynamicResource WindowBrush}"
					BorderBrush="{DynamicResource AccentBrush}"
					CaretBrush="{DynamicResource TextBrush}"
					FontFamily="Segoe UI"
					FontSize="15"
					Foreground="{DynamicResource TextBrush}"
					HorizontalScrollBarVisibility="Auto"
					TabIndex="2"
					Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap"
					ToolTip="Enter text to convert to UTF-8 bytes."
					VerticalScrollBarVisibility="Auto" />
				<TextBox
					Grid.Row="7"
					Grid.RowSpan="3"
					Grid.Column="0"
					Grid.ColumnSpan="10"
					Margin="5,0,0,0"
					Padding="4"
					AcceptsReturn="True"
					AutomationProperties.Name="Hexadecimal output"
					Background="{DynamicResource RaisedBrush}"
					BorderBrush="{DynamicResource AccentBrush}"
					CaretBrush="{DynamicResource TextBrush}"
					FontFamily="Segoe UI"
					FontSize="29"
					Foreground="{DynamicResource TextBrush}"
					HorizontalScrollBarVisibility="Auto"
					TabIndex="5"
					Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap"
					ToolTip="Uppercase hexadecimal UTF-8 bytes without separators, ready to copy."
					VerticalScrollBarVisibility="Auto" />
				<Button
					Grid.Row="3"
					Grid.Column="11"
					Margin="0"
					Padding="5"
					HorizontalContentAlignment="Stretch"
					Command="{Binding ConvertCommand}"
					FontSize="16"
					Style="{StaticResource TextToHexButtonStyle}"
					TabIndex="3"
					ToolTip="Convert the text to hexadecimal UTF-8 bytes.">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Image
							Grid.Column="0"
							Width="24"
							Height="24"
							Margin="0,0,4,0"
							Source="/Dialogs/TextToHexConvert.png" />
						<AccessText
							Grid.Column="1"
							HorizontalAlignment="Center"
							Text="Con_vert" />
					</Grid>
				</Button>
				<Button
					Grid.Row="7"
					Grid.Column="11"
					HorizontalContentAlignment="Stretch"
					Command="{Binding ClearCommand}"
					Style="{StaticResource TextToHexButtonStyle}"
					TabIndex="4"
					ToolTip="Clear the input and output.">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Image
							Grid.Column="0"
							Width="32"
							Height="32"
							HorizontalAlignment="Left"
							Source="/Dialogs/TextToHexClear.png" />
						<AccessText
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="C_lear"
							UseLayoutRounding="False" />
					</Grid>
				</Button>
				<Button
					Grid.Row="8"
					Grid.Column="11"
					HorizontalContentAlignment="Stretch"
					Command="{Binding CopyCommand}"
					Style="{StaticResource TextToHexButtonStyle}"
					TabIndex="6"
					ToolTip="Copy the converted text to the clipboard.">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Image
							Grid.Column="0"
							Width="32"
							Height="32"
							Margin="0,0,4,0"
							HorizontalAlignment="Left"
							Source="/Dialogs/TextToHexCopy.png" />
						<AccessText
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="_Copy" />
					</Grid>
				</Button>
				<Button
					Grid.Row="9"
					Grid.Column="11"
					HorizontalContentAlignment="Stretch"
					Click="HandleCloseClicked"
					Style="{StaticResource TextToHexButtonStyle}"
					TabIndex="7"
					ToolTip="Close this tool window.">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Image
							Grid.Column="0"
							Width="16"
							Height="16"
							Margin="0,0,4,0"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Source="/Dialogs/Close 16x16.png" />
						<AccessText
							Grid.Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="_Close" />
					</Grid>
				</Button>
			</Grid>
		</ScrollViewer>
	</Border>
</Page>

