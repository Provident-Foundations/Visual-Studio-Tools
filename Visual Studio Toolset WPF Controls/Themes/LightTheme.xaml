<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<SolidColorBrush x:Key="WindowBrush" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="RaisedBrush" Color="#FFF8F8F8" />
	<SolidColorBrush x:Key="BorderBrush" Color="#FFD6D6D6" />
	<SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="TextBrush" Color="#FF1E1E1E" />
	<SolidColorBrush x:Key="MutedTextBrush" Color="#FF616161" />
	<SolidColorBrush x:Key="AccentBrush" Color="#FF007ACC" />
	<SolidColorBrush x:Key="SelectionBrush" Color="#FFC9DEF5" />
	<SolidColorBrush x:Key="HoverBrush" Color="#FFE5F1FB" />
	<SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="EditorForegroundBrush" Color="#FF1E1E1E" />
	<SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
	<SolidColorBrush x:Key="SeverityNeutralBrush" Color="#FF666666" />
	<SolidColorBrush x:Key="SeverityErrorBrush" Color="#FFC42B1C" />
	<SolidColorBrush x:Key="SeverityWarningBrush" Color="#FF8A6D00" />
	<SolidColorBrush x:Key="SeverityInformationBrush" Color="#FF0066B8" />
	<LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FFFFFFFF" />
		<GradientStop Offset="1" Color="#FFC0C0FF" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="FrameGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FFFFFFFF" />
		<GradientStop Offset="1" Color="#FF8800FF" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FF003D66" />
		<GradientStop Offset="0.75" Color="#FF005E99" />
		<GradientStop Offset="1" Color="#FF003D66" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="HeaderBarGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FF111111" />
		<GradientStop Offset="0.5" Color="#FF8800FF" />
		<GradientStop Offset="1" Color="#FF333333" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ActionButtonGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FF8800FF" />
		<GradientStop Offset="1" Color="#FF333333" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="CloseButtonGradient" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FFFFFFFF" />
		<GradientStop Offset="1" Color="#FFDD0000" />
	</LinearGradientBrush>
	<Style x:Key="ActionButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="125" />
		<Setter Property="Height" Value="40" />
		<Setter Property="Padding" Value="6,3" />
		<Setter Property="Background" Value="{StaticResource ActionButtonGradient}" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="BorderBrush" Value="#FF000080" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="ButtonBorder"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background">
								<Setter.Value>
									<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
										<GradientStop Offset="0" Color="#FF888888" />
										<GradientStop Offset="1" Color="#FF8800FF" />
									</LinearGradientBrush>
								</Setter.Value>
							</Setter>
							<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF8800EE" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
							<Setter Property="Foreground" Value="Gray" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="CloseButtonStyle"
		BasedOn="{StaticResource ActionButtonStyle}"
		TargetType="Button">
		<Setter Property="Background" Value="{StaticResource CloseButtonGradient}" />
		<Setter Property="Foreground" Value="Black" />
		<Setter Property="BorderBrush" Value="#FF800000" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="ButtonBorder"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background">
								<Setter.Value>
									<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
										<GradientStop Offset="0" Color="#FFE0E0E0" />
										<GradientStop Offset="1" Color="#FFFFC0C0" />
									</LinearGradientBrush>
								</Setter.Value>
							</Setter>
							<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Red" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
